{
  "name": "pdfforge-viewer",
  "version": "1.0.0",
  "description": "A fast, private, offline desktop PDF viewer.",
  "main": "electron/main.js",
  "author": "PDFForge",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "make-icon": "node scripts/make-icon.mjs",
    "smoke": "electron . --smoke",
    "dist": "npm run make-icon && electron-builder --win nsis",
    "lint": "node --check electron/main.js && node --check electron/preload.js && node --check renderer/viewer.js"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.pdfforge.viewer",
    "productName": "PDFForge Viewer",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "node_modules/pdfjs-dist/build/**/*",
      "node_modules/pdfjs-dist/web/**/*",
      "!node_modules/pdfjs-dist/**/*.map",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "PDFForge Viewer",
          "description": "PDFForge Viewer document",
          "role": "Viewer"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}